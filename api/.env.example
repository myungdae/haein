# 아래 내용을 복사해서 .env 파일로 저장하세요
# cp .env.example .env

DB_HOST=localhost
DB_PORT=5432
DB_NAME=haein_db
DB_USER=haein_user
DB_PASS=CHANGE_ME_WITH_A_STRONG_DATABASE_PASSWORD

API_PORT=3000
# 로컬에서 API와 홈페이지를 한 번에 확인할 때만 true로 설정
SERVE_STATIC=false

# CMS 로그인 정보. 실제 값은 .env에만 저장하세요.
ADMIN_USERNAME=haein
ADMIN_PASSWORD=CHANGE_ME_WITH_A_STRONG_ADMIN_PASSWORD
ADMIN_SESSION_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# 구형 갤러리 토큰 방식이 꼭 필요한 배포 전환 기간에만 설정합니다.
# 새 /admin/은 로그인 쿠키를 사용하므로 비워 두어도 됩니다.
ADMIN_TOKEN=

# 이미지 저장 경로 (서버 절대경로)
UPLOAD_DIR=/var/www/haein.exko.kr/images/gallery
CMS_UPLOAD_DIR=/var/www/haein.exko.kr/images/cms
