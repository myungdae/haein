{
  "name": "haein-class-pwa",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "wrangler pages dev dist",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply haein-class-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply haein-class-db --remote",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "hono": "^4.13.4"
  },
  "devDependencies": {
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "@rolldown/binding-win32-x64-msvc": "^1.1.5",
    "vite": "^8.1.4",
    "wrangler": "^4.110.0"
  }
}
